# Copy to .env.production and fill in - never commit the real file.

# --- Domain -----------------------------------------------------------------
# With a real domain Caddy provisions HTTPS automatically (ports 80+443 must
# be reachable and DNS pointed at this server first).
SITE_ADDRESS=hr.aveoninfotech.com
PUBLIC_URL=https://hr.aveoninfotech.com
# Local smoke test instead:  SITE_ADDRESS=:80  PUBLIC_URL=http://localhost:8080  HTTP_PORT=8080

# --- Database ---------------------------------------------------------------
DB_USER=payslip
DB_PASSWORD=CHANGE_ME_long_random_password
DB_NAME=payslip

# --- Auth secrets (generate: openssl rand -hex 32) --------------------------
JWT_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_hex_chars_different

# Optional. Protects secrets kept in the database (the mail server password).
# If unset, JWT_SECRET is used; changing whichever is in use means typing the
# mail password in again (Company Settings -> Email).
# SETTINGS_SECRET=CHANGE_ME_64_hex_chars_third

# Optional. Number of proxies in front of the backend, so sign-in history and
# the rate limiter see the caller's own address. Defaults to 1 in production.
# TRUST_PROXY=1

# --- Optional port overrides ------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
