# Docker Compose Environment Configuration
# Copy this file to .env and customize for your environment

# Database Configuration
DB_USER=payslip_user
DB_PASSWORD=secure_password_change_me_in_production
DB_NAME=payslip_dev
DB_PORT=5432

# Node Environment
NODE_ENV=development

# Backend Configuration
BACKEND_PORT=3000
JWT_SECRET=your-long-secret-key-min-32-chars-for-production
JWT_REFRESH_SECRET=your-long-refresh-secret-min-32-chars-for-production
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api

# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
