# Override configuration for local development with hot reload
# This file is automatically loaded by docker-compose and overrides docker-compose.yml
# Only use this for LOCAL development - remove or modify for production

version: '3.8'

services:
  backend:
    # Enable hot reload with source code volumes
    volumes:
      - ./backend/src:/app/src
      - ./backend/prisma:/app/prisma
      - backend_node_modules:/app/node_modules  # Preserve node_modules
    # Override command to use nodemon for hot reload
    command: npm run dev
    environment:
      NODE_ENV: development

  frontend:
    # Enable hot reload with source code volumes
    volumes:
      - ./frontend/src:/app/src
      - ./frontend/public:/app/public
      - frontend_node_modules:/app/node_modules  # Preserve node_modules
    # Override command to use Vite dev server
    command: npm run dev
    environment:
      VITE_DEV_SERVER_HOST: 0.0.0.0

  pgadmin:
    # Enable pgAdmin in development by default
    profiles: []  # Remove 'dev' profile requirement

volumes:
  backend_node_modules:
  frontend_node_modules:
