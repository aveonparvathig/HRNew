# Database
DATABASE_URL="postgresql://user:password@localhost:5432/payslip_dev"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"

# Email (optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-app-password"
DEFAULT_FROM_EMAIL="noreply@yourcompany.com"

# File Storage
TEMP_FILE_EXPIRY_HOURS=24
MAX_FILE_SIZE_MB=100

# API
CORS_ORIGIN="http://localhost:5173"

# Optional: protects secrets kept in the database (mail server password); JWT_SECRET is used if unset
# SETTINGS_SECRET="another-long-random-string"
# Optional: where Chromium and qpdf are, for PDF files (the Docker image sets these up itself)
# CHROMIUM_PATH="/usr/bin/chromium"
# QPDF_PATH="/usr/bin/qpdf"
