generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------
model Organization {
  id           String @id @default(cuid())
  name         String
  tagline      String @default("")
  address      String @default("")
  city         String @default("")
  state        String @default("")
  country      String @default("India")
  phone        String @default("")
  email        String @default("")
  website      String @default("")
  jurisdiction String @default("")

  // Branding (logo stored as a data URI, resized client-side)
  logoData             String @default("")
  brandPrimary         String @default("#4f46e5")
  brandAccent          String @default("#312e81")
  signatoryName        String @default("")
  signatoryDesignation String @default("")
  // The default signatory's signature (data URI), printed where they sign
  signatureData        String @default("")
  logoPosition         String @default("LEFT") // LEFT | CENTER | RIGHT, in report and letter headers

  // Tenancy lifecycle, managed from the platform-owner console.
  // A SUSPENDED tenant's logins are refused (login, refresh and loadActor).
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  suspendedAt     DateTime?
  suspendedReason String    @default("")
  createdVia      String    @default("SIGNUP") // SIGNUP | OWNER

  // Plan & limits (platform-managed). No plan = no limits, all modules —
  // so existing tenants are unchanged until an owner assigns one. Overrides
  // beat the plan; null/empty = fall back to the plan. 0 = unlimited.
  planId               String?
  maxEmployeesOverride Int?
  maxUsersOverride     Int?
  trialEndsOn          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  users         User[]
  academicYears AcademicYear[]
  incomeClients IncomeClient[]
  jobPostings   JobPosting[]
  people        Person[]
  jobOpenings   JobOpening[]
  proposals     ProposalRecord[]
  payrollRuns   PayrollRun[]
  workLocations WorkLocation[]

  @@map("organizations")
}

// Platform owners live OUTSIDE every tenant: they run the SaaS itself and are
// never tied to an organizationId, so org-scoped queries and per-org role
// checks are untouched. Their tokens carry scope "PLATFORM" (see middleware).
// The first owner is seeded from env on boot; the rest are added in-console.
model PlatformAdmin {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String    @default("")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("platform_admins")
}

// Every platform-owner action is logged here. Only what changed is kept, never
// a tenant's own data values. organizationId is the tenant acted on, if any.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorEmail     String
  action         String
  organizationId String?
  detail         String   @default("")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("platform_audit_logs")
}

// A subscription tier. Platform-global (not per tenant); the owner edits these
// in the console. `enabledModules` lists the gated add-on modules a tenant on
// this plan may use (empty = all); the core HR directory is always available.
// 0 for a cap means unlimited; trialDays > 0 marks a plan as a trial.
model Plan {
  id             String   @id @default(cuid())
  code           String   @unique // TRIAL | STARTER | GROWTH | ENTERPRISE | ...
  name           String
  maxEmployees   Int      @default(0)
  maxUsers       Int      @default(0)
  enabledModules String[] // keys: project | recruitment | proposals | expenses | payroll
  trialDays      Int      @default(0)
  price          Int      @default(0) // monthly, in rupees — display only
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizations Organization[]

  @@map("plans")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  firstName          String    @default("")
  lastName           String    @default("")
  organizationId     String
  // Signup creates the org's first user, hence SUPER_ADMIN by default.
  // SUPER_ADMIN: everything · HR: people/recruitment/payroll/expenses ·
  // EMPLOYEE: own clients (income), people directory, own expenses ·
  // MARKETING: proposals they generated + own expenses ·
  // PAYROLL_VIEWER: reads payroll and people, changes nothing (auditors).
  role               String    @default("SUPER_ADMIN") // SUPER_ADMIN | HR | PAYROLL_VIEWER | EMPLOYEE | MARKETING
  isActive           Boolean   @default(true)
  // Employee logins link to their Person record — "own data" scoping key
  personId           String?   @unique
  mustChangePassword Boolean   @default(false)
  // Sign-in security: wrong passwords in a row, the lock they led to
  // (year 9999 = until an admin unlocks), and when the password was set
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person          Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  refreshTokens   RefreshToken[]
  passwordHistory PasswordHistory[]
  proposalRecords ProposalRecord[]
  clientVisits    ClientVisit[]

  @@index([organizationId])
  @@map("users")
}

// Refresh tokens survive restarts and are revocable; only the SHA-256 hash
// is stored so a database leak never exposes a usable token.
// The organization's sign-in rules. Defaults are what the app did before
// the rules existed, so nothing changes until a rule is switched on.
model PasswordPolicy {
  organizationId     String   @id
  minLength          Int      @default(8)
  lockoutAttempts    Int      @default(0) // 0 = accounts never lock
  lockoutMinutes     Int      @default(30) // 0 = until an admin unlocks
  expiryDays         Int      @default(0) // 0 = passwords never expire
  expiryReminderDays Int      @default(7)
  historyCount       Int      @default(0) // 0 = an old password may be reused
  tempPasswordDays   Int      @default(0) // 0 = a temporary password never expires
  updatedAt          DateTime @updatedAt

  @@map("password_policies")
}

// Hashes of a user's earlier passwords, to refuse reuse.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

// One sign-in attempt on a known account.
model LoginEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  email          String
  result         String // SUCCESS | WRONG_PASSWORD | LOCKED | DISABLED | TEMP_EXPIRED
  ip             String   @default("")
  userAgent      String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("login_events")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Income module
// Date-only values (receivedOn, nextFollowupDate, agreement dates, ...) are
// stored as ISO "YYYY-MM-DD" strings: they sort lexicographically and the
// application layer compares them as strings throughout.
// ---------------------------------------------------------------------------
model AcademicYear {
  id             String   @id @default(cuid())
  organizationId String
  label          String // "2025-2026"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, label])
  @@map("academic_years")
}

model IncomeClient {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  agreementStatus String   @default("")
  notes           String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billings     ClientBilling[]
  payments     PaymentReceipt[]
  onboarding   ClientOnboarding?
  features     FeatureStatus[]
  visits       ClientVisit[]

  @@unique([organizationId, name])
  @@map("income_clients")
}

model ClientBilling {
  id               String   @id @default(cuid())
  clientId         String
  organizationId   String
  // ACADEMIC: academicYear holds the label ("2024-2025").
  // CUSTOM: academicYear holds the cycle's start date ("2026-02-01") so the
  // (clientId, academicYear) uniqueness and chronological sort keep working;
  // periodStart/periodEnd carry the actual contract dates.
  periodType       String   @default("ACADEMIC") // ACADEMIC | CUSTOM
  periodStart      String?
  periodEnd        String?
  academicYear     String // "2024-2025"
  yearStart        Int      @default(0)
  studentCount     Int?
  rate             Float?
  oneTimePayment   Float    @default(0)
  overrideAmounts  Boolean  @default(false)
  taxableValue     Float?
  gstAmount        Float    @default(0)
  netAmount        Float    @default(0)
  previousPending  Float    @default(0)
  engineer         String   @default("")
  invoiceStatus    String   @default("")
  remarks          String   @default("")
  nextFollowupDate String?
  followupNote     String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client   IncomeClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments PaymentReceipt[]

  @@unique([clientId, academicYear])
  @@index([organizationId, yearStart])
  @@index([organizationId, nextFollowupDate])
  @@map("client_billings")
}

model PaymentReceipt {
  id             String   @id @default(cuid())
  billingId      String
  clientId       String
  organizationId String
  amount         Float
  receivedOn     String? // null = imported opening figure
  mode           String   @default("")
  note           String   @default("")
  createdAt      DateTime @default(now())

  billing ClientBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  client  IncomeClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("payment_receipts")
}

model ClientOnboarding {
  clientId              String   @id
  organizationId        String
  stage                 String   @default("ONBOARDING")
  contactPerson         String   @default("")
  contactDesignation    String   @default("")
  contactPhone          String   @default("")
  contactEmail          String   @default("")
  institutionType       String   @default("")
  address               String   @default("")
  city                  String   @default("")
  studentStrength       Int?
  onboardedOn           String?
  goLiveDate            String?
  engineer              String   @default("") // kept in sync with the latest billing engineer
  supportEngineer       String   @default("") // second engineer on larger institutions
  poReceived            Boolean  @default(false)
  poNumber              String   @default("")
  poDate                String?
  poDocumentData        String   @default("") // data URI (pdf/image), <=8MB
  poFilename            String   @default("")
  agreementSigned       Boolean  @default(false)
  agreementDocumentData String   @default("") // data URI (pdf/image), <=8MB
  agreementFilename     String   @default("")
  agreementYears        Int?
  agreementStart        String?
  agreementEnd          String?
  reminderDays          Int      @default(90)
  notes                 String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client IncomeClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("client_onboardings")
}

// Site-visit attendance: which engineer was at which client, when, what
// they worked on and whom they met. Any client is loggable; ownership
// (createdById) gates edits, visibility is org-wide.
model ClientVisit {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  engineerName   String   @default("") // forced to own Person name for employees
  visitDate      String // "YYYY-MM-DD"
  timeIn         String   @default("") // "HH:MM"
  timeOut        String   @default("")
  workDone       String   @default("")
  metPersons     String   @default("") // "Name (Designation), ..."
  followupNote   String   @default("")
  followupDate   String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client    IncomeClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, visitDate])
  @@index([clientId])
  @@map("client_visits")
}

// ---------------------------------------------------------------------------
// Proposals & quotations - every generated proposal is kept, org-scoped,
// with a revision chain per client. The rendered HTML is stored verbatim
// so history shows exactly what was sent.
// ---------------------------------------------------------------------------
model ProposalRecord {
  id             String   @id @default(cuid())
  organizationId String
  clientName     String
  revision       Int      @default(1)
  selectionLabel String   @default("")
  totalAmount    Float    @default(0)
  formData       Json     @default("{}") // snapshot - prefills the next revision
  html           String
  // Who generated it — MARKETING users only ever see their own records
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, clientName])
  @@map("proposal_records")
}

// ---------------------------------------------------------------------------
// People registry - candidates & internship students, with a lightweight
// recruitment pipeline (job openings + interview rounds).
// ---------------------------------------------------------------------------
model Person {
  id             String @id @default(cuid())
  organizationId String
  kind           String // CANDIDATE | INTERN
  name           String
  title          String @default("") // Mr./Ms./Mrs.
  gender         String @default("")
  email          String @default("")
  phone          String @default("")
  address        String @default("")
  notes          String @default("")

  // Candidate / employee
  isEmployee  Boolean @default(false) // auto-set when pipeline stage reaches SELECTED/JOINED
  employeeNo  String  @default("")
  designation String  @default("")
  department  String  @default("")
  joinDate    String?
  leavingDate String?

  // HR profile: personal
  photoData        String  @default("") // data URI, resized client-side
  dateOfBirth      String?
  bloodGroup       String  @default("")
  maritalStatus    String  @default("")
  parentSpouseName String  @default("")
  aadharNo         String  @default("")

  // HR profile: contact (email = personal, phone = contact no)
  officialEmail String @default("")
  officialNo    String @default("")
  emergencyNo   String @default("")

  // HR profile: employment
  employmentStatus      String  @default("ACTIVE") // ACTIVE | PROBATION | NOTICE_PERIOD | RESIGNED | TERMINATED
  biometricId           String  @default("")
  agreementSigned       Boolean @default(false)
  agreementSignDate     String?
  currentMonthlyPackage Float   @default(0)
  reasonForLeaving      String  @default("")
  // Drives state-wise statutory rules (Professional Tax, Labour Welfare Fund)
  workLocationId        String?

  // Bank & statutory
  bankName          String  @default("")
  bankAccountNumber String  @default("")
  ifscCode          String  @default("")
  panNumber         String  @default("")
  pfNumber          String  @default("")
  pfUan             String  @default("")
  esiNumber         String  @default("")
  isEsiEligible     Boolean @default(false)
  isPfApplicable    Boolean @default(false)
  // How salary is paid, and whether payroll should leave the employee out
  paymentMode       String  @default("BANK") // BANK | CHEQUE | CASH
  salaryStopped     Boolean @default(false)
  salaryStopReason  String  @default("")

  // Recruitment pipeline
  source         String    @default("")
  stage          String    @default("")
  appliedForId   String?
  expectedCtc    Float?
  stageUpdatedAt DateTime?

  // Internship student
  rollNumber     String  @default("")
  course         String  @default("")
  collegeName    String  @default("")
  collegeAddress String  @default("")
  internshipRole String  @default("")
  startDate      String?
  endDate        String?

  // HR profile: fuller personal (phase 24). address above is the present
  // address; parentSpouseName is kept for the PF/ESI registers and is set
  // from fatherName.
  fatherName           String  @default("")
  spouseName           String  @default("")
  marriageDate         String?
  nationality          String  @default("")
  placeOfBirth         String  @default("")
  residentialStatus    String  @default("") // RESIDENT | NON_RESIDENT | NOT_ORDINARILY_RESIDENT
  religion             String  @default("")
  physicallyChallenged Boolean @default(false)
  disabilityType       String  @default("")
  isDirector           Boolean @default(false)
  permanentAddress     String  @default("")
  // Emergency contact (phase 24); emergencyNo above is the phone
  emergencyName        String  @default("")
  emergencyRelation    String  @default("")
  // Bank, fuller (phase 24)
  bankAccountName      String  @default("") // name as it reads on the bank account
  bankBranch           String  @default("")
  bankAccountType      String  @default("") // SAVINGS | CURRENT
  // Statutory, fuller (phase 24). lwfCovered is recorded but not yet wired
  // into payroll, which still follows the work-location LWF policy.
  pfJoinDate           String?
  epsMember            Boolean @default(false)
  lwfCovered           String  @default("AUTO") // AUTO | YES | NO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appliedFor          JobOpening?          @relation(fields: [appliedForId], references: [id], onDelete: SetNull)
  workLocation        WorkLocation?        @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  interviews          InterviewRound[]
  documents           PersonDocument[]
  files               EmployeeDocument[]
  payslipEntries      PayslipEntry[]
  salaryRevisions     SalaryRevision[]
  loans               Loan[]
  taxProfiles         EmployeeTaxProfile[]
  form16PartAs        Form16PartA[]
  perquisiteValues    PerquisiteValue[]
  recurringComponents RecurringComponent[]
  positionChanges     PositionChange[]

  // The employer's contribution to the National Pension System, as a
  // share of Basic + DA (0 = none), and the employee's PRAN
  npsEmployerPercent   Float  @default(0)
  npsPran              String @default("")
  // SALARY: an employee, taxed on salary. CONSULTANT: paid professional or
  // contract fees through payroll, with tax deducted at a flat rate under
  // the section given and no PF, ESI, Professional Tax or LWF.
  taxTreatment         String @default("SALARY")
  consultantSection    String @default("194J")
  consultantTdsPercent Float  @default(10)

  // Job details
  employmentType      String                  @default("") // a value of the EMPLOYMENT_TYPE list
  // A value of the GRADE list. Designation, department, work location and
  // grade here are the position today; PositionChange holds how it got there
  grade               String                  @default("")
  // Probation in months from the joining date; 0 = none. The employee is
  // due for confirmation when it ends, until a confirmation date is set.
  probationMonths     Int                     @default(0)
  confirmationDate    String? // "YYYY-MM-DD"
  // Notice the employee must give, in days; null = the company's usual one
  noticePeriodDays    Int?
  firstHireDate       String? // for someone rehired
  referredBy          String                  @default("")
  // Who the employee reports to
  managerId           String?
  manager             Person?                 @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports             Person[]                @relation("ReportsTo")
  arrearItems         ArrearItem[]
  settlements         Settlement[]
  familyMembers       FamilyMember[]
  educations          Education[]
  previousEmployments PreviousEmployment[]
  identityDocuments   IdentityDocument[]
  separation          Separation?
  changeRequests      ChangeRequest[]
  policyAcks          PolicyAcknowledgement[]
  // When the employee last confirmed their details are up to date (data drive)
  detailsConfirmedAt  DateTime?
  expenseReports      ExpenseReport[]
  user                User?

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, stage])
  @@index([managerId])
  @@map("people")
}

model JobOpening {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  department     String   @default("")
  positions      Int      @default(1)
  location       String   @default("")
  description    String   @default("")
  status         String   @default("OPEN") // OPEN | ON_HOLD | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicants   Person[]

  @@index([organizationId, status])
  @@map("job_openings")
}

model PersonDocument {
  id                String   @id @default(cuid())
  organizationId    String
  personId          String
  docType           String // the code of the letter template it was written from
  title             String
  formData          Json     @default("{}") // snapshot - prefills the next letter of the same type
  html              String // the letter exactly as issued
  // The template as it stood is not kept: the html is. This only says which one.
  templateId        String?
  // Shown to the employee under My Documents
  visibleToEmployee Boolean  @default(false)
  createdByName     String   @default("")
  createdAt         DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, docType])
  @@map("person_documents")
}

// A letter HR can issue, as editable text. Each company starts with the
// built-in ones (offer, appointment, confirmation, experience, relieving
// and the two for interns), made on first use; a built-in one can be
// reworded or switched off but not deleted. See services/letterEngine.ts
// for what the text may hold.
model LetterTemplate {
  id             String   @id @default(cuid())
  organizationId String
  code           String // EMPLOYMENT_OFFER … for the built-in ones, else made from the name
  name           String
  audience       String   @default("CANDIDATE") // CANDIDATE (employees and candidates) | INTERN
  subject        String   @default("")
  salutation     String   @default("")
  body           String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  updatedByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@map("letter_templates")
}

// A file kept against an employee: an identity proof, a certificate, a
// signed letter. The file itself is either in the row (a data URI) or in
// the company's object storage, as the row says.
model EmployeeDocument {
  id                String   @id @default(cuid())
  organizationId    String
  personId          String
  category          String // a value of the DOCUMENT_CATEGORY list
  title             String
  documentDate      String? // "YYYY-MM-DD": the date on the document, when it has one
  fileName          String
  mimeType          String
  sizeBytes         Int
  fileData          String   @default("") // data URI; empty when the file is in object storage
  // Where this file is: DB (fileData) or S3 (storageKey in the bucket of
  // StorageSettings). A file stays where it was put until it is moved.
  storage           String   @default("DB")
  storageKey        String   @default("")
  visibleToEmployee Boolean  @default(false)
  uploadedByName    String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
  @@map("employee_documents")
}

// An employee's qualifications.
model Education {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  qualification  String
  institute      String   @default("")
  fromYear       Int?
  toYear         Int?
  grade          String   @default("")
  isHighest      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
  @@map("education")
}

// Where an employee worked before. Total prior experience is worked out
// from these.
model PreviousEmployment {
  id               String   @id @default(cuid())
  organizationId   String
  personId         String
  employer         String
  designation      String   @default("")
  fromDate         String? // "YYYY-MM" or "YYYY-MM-DD"
  toDate           String?
  lastSalary       Float    @default(0)
  reasonForLeaving String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
  @@map("previous_employments")
}

// Identity proofs held against an employee, any number each. PAN and
// Aadhaar already on the profile show as rows too, until a real one of
// that type is added.
model IdentityDocument {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  docType        String // PAN | AADHAAR | PASSPORT | DRIVING_LICENCE | VOTER_ID
  number         String    @default("")
  nameOnDocument String    @default("")
  expiryDate     String? // "YYYY-MM-DD"
  fileName       String    @default("")
  mimeType       String    @default("")
  sizeBytes      Int       @default(0)
  fileData       String    @default("") // data URI; empty when in object storage
  storage        String    @default("DB")
  storageKey     String    @default("")
  verified       Boolean   @default(false)
  verifiedByName String    @default("")
  verifiedAt     DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
  @@index([organizationId, docType])
  @@map("identity_documents")
}

model InterviewRound {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  roundName      String
  scheduledAt    String? // "YYYY-MM-DDTHH:mm"
  interviewer    String   @default("")
  feedback       String   @default("")
  rating         Int?
  result         String   @default("PENDING") // PENDING | PASSED | FAILED
  createdAt      DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("interview_rounds")
}

// ---------------------------------------------------------------------------
// Travel & expense reports - per employee, receipt images attached per line
// (captured via in-browser OCR), approval workflow.
// ---------------------------------------------------------------------------
model ExpenseReport {
  id                String   @id @default(cuid())
  organizationId    String
  personId          String
  reportNumber      String // ER-2026-0001
  title             String
  businessPurpose   String   @default("")
  reportTo          String   @default("")
  periodStart       String?
  periodEnd         String?
  submittedOn       String?
  status            String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | REIMBURSED
  currency          String   @default("INR")
  // Set while the claim is being paid with a month's salary
  payrollEntryId    String?
  // Approval routing up the reporting line (phase 26 org chart). Null
  // approver + level 0 = no chain (top-level employee) -> HR approves.
  currentApproverId String?
  approvalLevel     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payrollEntry PayslipEntry?     @relation(fields: [payrollEntryId], references: [id], onDelete: SetNull)
  // Restrict, like payslips: an employee with expense history stays on record.
  person       Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  lines        ExpenseLine[]
  approvals    ExpenseApproval[]

  @@unique([organizationId, reportNumber])
  @@index([organizationId, status])
  @@index([personId])
  @@index([payrollEntryId])
  @@map("expense_reports")
}

// One step of an expense report's approval chain (phase 26). Levels run
// 1 = direct manager up to the top; each is signed off in order.
model ExpenseApproval {
  id             String    @id @default(cuid())
  organizationId String
  reportId       String
  level          Int
  approverId     String // the Person who signs this level
  approverName   String    @default("") // snapshot, in case they later leave
  decision       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note           String    @default("")
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  report ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, level])
  @@index([organizationId, approverId])
  @@map("expense_approvals")
}

model ExpenseLine {
  id              String   @id @default(cuid())
  organizationId  String
  reportId        String
  date            String?
  category        String   @default("OTHER") // TRAVEL | LODGING | FOOD | LOCAL | TOLL | OTHER
  description     String   @default("")
  merchant        String   @default("")
  amount          Float    @default(0)
  receiptData     String   @default("") // image/PDF data URI
  receiptFilename String   @default("")
  ocrText         String   @default("") // raw OCR output kept for audit
  createdAt       DateTime @default(now())

  report ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("expense_lines")
}

// ---------------------------------------------------------------------------
// Payroll - org-level rates, monthly runs, computed payslip entries.
// Defaults reproduce the source Salary Excel's hardcoded values exactly.
// ---------------------------------------------------------------------------
model PayrollSettings {
  organizationId String @id

  basicPercentOfPackage   Float @default(50)
  daPercentOfBasic        Float @default(45)
  hraPercentOfBasic       Float @default(25)
  transportPercentOfBasic Float @default(20)
  foodPercentOfBasic      Float @default(10)

  esiEmployeePercent Float   @default(0.75)
  esiEmployerPercent Float   @default(3.25)
  esiWageCeiling     Float   @default(21000)
  // Off: ESI follows each employee's flag. On: new runs cover everyone
  // whose wage is within the ceiling, and keep them covered until the
  // contribution period (Apr–Sep / Oct–Mar) ends.
  esiAutoCoverage    Boolean @default(false)

  pfEmployeePercent         Float   @default(12)
  pfEmployerPercent         Float   @default(12)
  pfWageCap                 Float   @default(15000)
  pfWageFactor              Float   @default(60)
  pfEmployerMatchesEmployee Boolean @default(true)
  pfRoundToRupee            Boolean @default(false)
  // Employer-side split and charges — reported, not deducted from pay
  epsPercent                Float   @default(8.33)
  epsWageCap                Float   @default(15000)
  edliPercent               Float   @default(0.5)
  edliWageCap               Float   @default(15000)
  pfAdminPercent            Float   @default(0.5)
  pfAdminMinimum            Float   @default(500)

  // Loan perquisite: interest the employee saves against this benchmark
  // rate is taxable, unless their loans total no more than the limit.
  loanBenchmarkRate         Float @default(0)
  loanPerquisiteExemptLimit Float @default(20000)

  // Income tax: TDS is typed by hand until this month ("YYYY-MM"); from it
  // onward payroll computes it. Blank keeps TDS manual.
  tdsAutoFrom             String  @default("")
  defaultTaxRegime        String  @default("NEW") // NEW | OLD, when an employee has none set
  // Titles printed on the tax forms. The Income-tax Act, 2025 renumbers
  // them, so they are data: set them to what the year's rules call them.
  form24qName             String  @default("Form 24Q")
  form16Name              String  @default("Form 16")
  form12baName            String  @default("Form 12BA")
  form27aName             String  @default("Form 27A")
  // Quarterly return: list employees with no tax deducted in Annexure I,
  // and leave employees with no tax for the year out of Annexure II
  tdsAnnexure1IncludeZero Boolean @default(false)
  tdsAnnexure2SkipZero    Boolean @default(false)

  // Arrears and final settlement
  lopReversalMonths  Int   @default(6) // how far back loss of pay can be reversed
  noticePeriodDays   Int   @default(30) // the usual notice period, as a starting value
  settlementDayBasis Int   @default(30) // days in a month for leave encashment and notice pay
  gratuityMinYears   Int   @default(5)
  gratuityCap        Float @default(2000000)

  // Statutory bonus: a share of Basic + DA, counted up to a monthly ceiling,
  // for employees whose Basic + DA is within the eligibility limit
  bonusPercent          Float @default(8.33)
  bonusEligibilityLimit Float @default(21000)
  bonusWageCeiling      Float @default(7000)

  // On finalizing a run: release its payslips, and open next month's run
  autoReleaseOnFinalize Boolean @default(false)
  autoCreateNextRun     Boolean @default(false)
  // The account salaries are paid from, printed on the bank advice
  payoutBankName        String  @default("")
  payoutBranch          String  @default("")
  payoutAccountNumber   String  @default("")
  payoutIfsc            String  @default("")
  // Payslips as files and by email
  payslipPdfPassword    String  @default("NONE") // NONE | PAN | DOB
  payslipFilePrefix     String  @default("Payslip")
  payslipFileContext    String  @default("EMPNO") // EMPNO | NAME | EMPNO_NAME
  payslipEmailTo        String  @default("OFFICIAL") // OFFICIAL | PERSONAL; the other is used when blank
  // On releasing a run's payslips: mail nobody (NONE), a notice that the
  // payslip can be seen (NOTICE), or the payslip itself (PAYSLIP)
  releaseMail           String  @default("NONE")
  jvFilePrefix          String  @default("JV") // journal voucher download
  // Journal voucher as one voucher ("") or one per DEPARTMENT / LOCATION
  jvSplitBy             String  @default("")
  // Day of the month after which a draft run's inputs lock on their own
  // (0 = locked by hand only; 31 = the month's last day)
  inputCutoffDay        Int     @default(0)

  updatedAt DateTime @updatedAt

  @@map("payroll_settings")
}

// The mail server the organization sends through (any SMTP service).
// Nothing is sent until it is switched on.
model MailSettings {
  organizationId String   @id
  enabled        Boolean  @default(false)
  host           String   @default("")
  port           Int      @default(587)
  security       String   @default("STARTTLS") // STARTTLS | SSL | NONE
  username       String   @default("")
  passwordEnc    String   @default("") // encrypted, see services/secretBox.ts
  fromName       String   @default("")
  fromEmail      String   @default("")
  replyTo        String   @default("")
  // Mail a new login its sign-in address and temporary password
  welcomeMail    Boolean  @default(false)
  // The address employees sign in at, for links in mails
  appUrl         String   @default("")
  updatedAt      DateTime @updatedAt

  @@map("mail_settings")
}

// One bulk import: who ran it, on what file, and what became of each row.
// The rows say what happened and why, and which fields changed — never
// the values, so the log holds no PAN, bank account or salary.
model FamilyMember {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  name           String
  relation       String // Spouse | Son | Daughter | Father | Mother | ...
  dateOfBirth    String?
  isDependant    Boolean  @default(false)
  nomineeShare   Float    @default(0) // % of the nomination; 0 = not a nominee
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
  @@map("family_members")
}

model Separation {
  id                  String   @id @default(cuid())
  organizationId      String
  personId            String   @unique
  mode                String // RESIGNATION | TERMINATION | CONTRACT_END | RETIREMENT | DEATH
  status              String   @default("SUBMITTED") // SUBMITTED | ACCEPTED | RELIEVED | WITHDRAWN
  submittedOn         String?
  reason              String   @default("")
  noticeDays          Int?
  noticeLastDay       String?
  agreedLastDay       String?
  noticeShortfallDays Int      @default(0)
  noticeWaived        Boolean  @default(false)
  remarks             String   @default("")
  relievedOn          String?
  assetsReturned      Boolean  @default(false)
  accessRevoked       Boolean  @default(false)
  handoverDone        Boolean  @default(false)
  exitInterviewDone   Boolean  @default(false)
  fitToRehire         String   @default("")
  acceptedByName      String   @default("")
  relievedByName      String   @default("")
  createdByName       String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("separations")
}

model ImportLog {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // EMPLOYEES_ADD | EMPLOYEES_UPDATE | SALARY_REVISIONS | PHOTOS | DOCUMENTS
  fileName       String
  ranByName      String   @default("")
  summary        Json     @default("{}") // counts by result
  rows           Json     @default("[]") // { row, employeeNo, name, result, messages[] }
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("import_logs")
}

// Where a company's uploaded files go. No row, or provider DB = in the
// database. S3 = an object store that speaks the S3 interface (Amazon S3,
// Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO).
model StorageSettings {
  organizationId String   @id
  provider       String   @default("DB") // DB | S3
  endpoint       String   @default("") // '' = Amazon S3 itself
  region         String   @default("")
  bucket         String   @default("")
  accessKeyId    String   @default("")
  secretEnc      String   @default("") // encrypted, see services/secretBox.ts
  prefix         String   @default("") // a folder inside the bucket
  forcePathStyle Boolean  @default(false)
  updatedByName  String   @default("")
  updatedAt      DateTime @updatedAt

  @@map("storage_settings")
}

// Every mail the system tried to send.
model MailLog {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // PAYSLIP | TEST | WELCOME | NOTICE
  toEmail        String
  subject        String
  status         String // SENT | FAILED
  error          String   @default("")
  runId          String?
  entryId        String?
  personId       String?
  personName     String   @default("")
  sentBy         String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([runId])
  @@map("mail_logs")
}

model PayrollRun {
  id             String    @id @default(cuid())
  organizationId String
  period         String // "YYYY-MM"
  status         String    @default("DRAFT") // DRAFT | FINALIZED
  finalizedAt    DateTime?
  // Employees see their payslip for this month only once it is released
  releasedAt     DateTime?
  // While a draft's inputs are locked, attendance and one-offs cannot be edited
  inputsLockedAt DateTime?
  // The automatic cutoff has had its turn: inputs unlocked by hand after
  // it stay unlocked
  cutoffApplied  Boolean   @default(false)
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         PayslipEntry[]
  taxComputations TaxComputation[]
  payoutBatches   PayoutBatch[]

  @@unique([organizationId, period])
  @@map("payroll_runs")
}

model PayslipEntry {
  id             String @id @default(cuid())
  organizationId String
  runId          String
  personId       String

  // Snapshot at entry-creation time so a later increment never
  // retroactively changes an already-generated month.
  monthlyPackage       Float
  // The structure template the pay was split with: its name, and its
  // percentages as JSON. Blank = the company's own split in Payroll Settings.
  structureName        String @default("")
  structureSplit       String @default("")
  // Employer's NPS contribution for the month: part of CTC, not of pay
  npsEmployer          Float  @default(0)
  // A consultant's fee: the section tax was deducted under and the rate.
  // Blank = salary.
  consultantSection    String @default("")
  consultantTdsPercent Float  @default(0)

  // Attendance - manual inputs.
  totalWorkingDays Int
  empLeaveDays     Float @default(0)
  lopDays          Float @default(0)
  presentDays      Float @default(0)
  payDays          Float @default(0)

  // Rare manual one-offs.
  internetAllowance     Float   @default(0)
  salaryArrearAllowance Float   @default(0)
  salaryAdvance         Float   @default(0)
  tds                   Float   @default(0)
  // Under computed TDS: true when the amount was typed over the calculation
  tdsOverridden         Boolean @default(false)

  // Computed components.
  basic              Float @default(0)
  da                 Float @default(0)
  hra                Float @default(0)
  transportAllowance Float @default(0)
  foodAllowance      Float @default(0)
  grossSalary        Float @default(0)

  isEsiEligible  Boolean @default(false)
  esiEmployee    Float   @default(0)
  esiEmployer    Float   @default(0)
  isPfApplicable Boolean @default(false)
  pfWage         Float   @default(0)
  pfEmployee     Float   @default(0)
  pfEmployer     Float   @default(0)

  // State-wise statutory deductions, from the employee's work location
  professionalTax Float   @default(0)
  ptOverridden    Boolean @default(false)
  lwfEmployee     Float   @default(0)
  lwfEmployer     Float   @default(0)

  // Loan instalments falling due this month (principal + interest)
  loanDeduction Float @default(0)

  totalDeductions       Float @default(0)
  netPayable            Float @default(0)
  employerContributions Float @default(0)
  ctc                   Float @default(0)

  // Approved expense claims paid with this salary. Not part of gross or
  // net: untaxed, shown separately, and added to the amount transferred.
  reimbursement Float @default(0)

  // Payout. A held salary is computed but not paid until released.
  payStatus      String    @default("PAY") // PAY | HOLD
  holdReason     String    @default("")
  heldAt         DateTime?
  holdReleasedAt DateTime?
  payoutBatchId  String?
  paidOn         String? // "YYYY-MM-DD", set when its batch is marked paid
  paymentRef     String    @default("") // cheque number or transfer reference

  remarks   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payoutBatch    PayoutBatch?           @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  expenseReports ExpenseReport[]
  tdsAllocations TdsChallanAllocation[]
  arrearsRaised  ArrearItem[]           @relation("ArrearSource")
  arrearsPaid    ArrearItem[]           @relation("ArrearPaid")
  settlements    Settlement[]
  run            PayrollRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Restrict, deliberately: a person with payslip history can never be
  // deleted, only marked inactive.
  person         Person                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  lines          PayslipLine[]

  @@unique([runId, personId])
  @@index([organizationId])
  @@index([payoutBatchId])
  @@map("payslip_entries")
}

// Org-level catalogue of pay components beyond the fixed salary split
// (bonus, incentive, other deduction, ...). The fixed components — Basic,
// DA, HRA, Transport, Food, Internet, Arrear, ESI, PF, Advance, TDS — stay
// as columns on PayslipEntry and are not rows here.
model PayComponent {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String // EARNING | DEDUCTION
  taxable        Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines     PayslipLine[]
  recurring RecurringComponent[]

  @@unique([organizationId, code])
  @@map("pay_components")
}

// One catalogue component on one payslip. Name and type are snapshots so
// renaming a component never rewrites an issued payslip.
model PayslipLine {
  id             String @id @default(cuid())
  organizationId String
  entryId        String
  componentId    String
  name           String
  type           String // EARNING | DEDUCTION
  amount         Float
  remarks        String @default("")
  // "" = entered by hand. ARREAR, SETTLEMENT and RECURRING lines are
  // written by those features and cannot be edited on the payslip.
  source         String @default("")

  entry     PayslipEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  component PayComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([entryId, componentId])
  @@index([organizationId])
  @@map("payslip_lines")
}

// A salary split of its own: the same percentages Payroll Settings holds
// for the company, for the employees the template is assigned to.
model StructureTemplate {
  id                      String   @id @default(cuid())
  organizationId          String
  name                    String
  basicPercentOfPackage   Float
  daPercentOfBasic        Float
  hraPercentOfBasic       Float
  transportPercentOfBasic Float
  foodPercentOfBasic      Float
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  assignments StructureAssignment[]

  @@unique([organizationId, name])
  @@map("structure_templates")
}

// Who a template applies to: one employee, everyone with a designation, or
// everyone in a department. The narrowest match wins; with none, the
// company's split applies.
model StructureAssignment {
  id             String @id @default(cuid())
  organizationId String
  scope          String // EMPLOYEE | DESIGNATION | DEPARTMENT
  target         String // the person's id, or the designation / department label
  templateId     String

  template StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, target])
  @@map("structure_assignments")
}

// A catalogue component paid (or deducted) every month for one employee.
// It is put on each payslip of the months it covers as a RECURRING line.
model RecurringComponent {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  componentId    String
  amount         Float // for a full month
  fromPeriod     String // "YYYY-MM"
  toPeriod       String   @default("") // "" = until changed
  prorate        Boolean  @default(true) // reduce for loss-of-pay days
  remarks        String   @default("")
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  component PayComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([organizationId, personId])
  @@map("recurring_components")
}

// How a running number is written: employee codes, letter references,
// settlement and payment-batch numbers. No row = not numbered by a series.
model NumberSeries {
  organizationId String
  key            String // EMPLOYEE_CODE | LETTER | SETTLEMENT | PAYOUT_BATCH
  prefix         String   @default("")
  suffix         String   @default("")
  padding        Int      @default(4)
  nextNumber     Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@id([organizationId, key])
  @@map("number_series")
}

// Salary history. A revision applies to payroll runs for the month of
// effectiveFrom and later.
model SalaryRevision {
  id                String   @id @default(cuid())
  organizationId    String
  personId          String
  effectiveFrom     String // "YYYY-MM-DD", always the first of a month
  oldMonthlyPackage Float
  newMonthlyPackage Float
  reason            String   @default("")
  createdByName     String   @default("")
  createdAt         DateTime @default(now())

  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  arrearItems ArrearItem[]

  @@index([organizationId, personId])
  @@map("salary_revisions")
}

// Income-tax rules of one regime for one financial year (fyStart 2026 =
// FY 2026-27). Everything a Budget can change lives here, not in code.
model TaxRegimeConfig {
  id             String @id @default(cuid())
  organizationId String
  fyStart        Int
  regime         String // NEW | OLD

  standardDeduction       Float
  // Rebate: tax up to rebateMaxAmount is waived when taxable income is
  // within rebateIncomeLimit; with marginal relief, tax just above the
  // limit is capped at the income over it.
  rebateIncomeLimit       Float
  rebateMaxAmount         Float
  rebateMarginalRelief    Boolean @default(false)
  cessPercent             Float   @default(4)
  // Higher tax-free limit for ages 60+ and 80+ (0 = no special limit)
  seniorExemption         Float   @default(0)
  superSeniorExemption    Float   @default(0)
  // Old-regime reliefs: HRA exemption, Professional Tax, Chapter VI-A
  // deductions and interest on a housing loan
  allowsExemptions        Boolean @default(false)
  section80CLimit         Float   @default(150000)
  housingInterestLimit    Float   @default(200000)
  // Most Professional Tax that can be deducted from salary income in the
  // year (0 = no limit)
  professionalTaxLimit    Float   @default(2500)
  // Employer's NPS contribution deductible up to this share of Basic + DA (section 80CCD(2))
  employerNpsLimitPercent Float   @default(10)

  updatedAt DateTime @updatedAt

  slabs TaxSlab[]

  @@unique([organizationId, fyStart, regime])
  @@map("tax_regime_configs")
}

// A band of taxable income. surchargePercent applies to the whole tax
// when total income falls in this band.
model TaxSlab {
  id               String @id @default(cuid())
  configId         String
  incomeFrom       Float
  incomeTo         Float? // null = no upper limit
  ratePercent      Float
  surchargePercent Float  @default(0)

  config TaxRegimeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("tax_slabs")
}

// What one employee has told payroll for one financial year.
model EmployeeTaxProfile {
  id             String @id @default(cuid())
  organizationId String
  personId       String
  fyStart        Int
  regime         String @default("") // NEW | OLD | "" = organization default

  prevEmployerIncome  Float   @default(0)
  prevEmployerTds     Float   @default(0)
  otherIncome         Float   @default(0)
  annualRentPaid      Float   @default(0)
  isMetro             Boolean @default(false)
  landlordName        String  @default("")
  landlordPan         String  @default("")
  housingLoanInterest Float   @default(0)

  // Proof of investment: once considered, tax uses the approved amounts
  // (an item with nothing approved counts as nil) instead of the declared.
  poiConsidered           Boolean   @default(false)
  rentApproved            Float?
  housingInterestApproved Float?
  submittedAt             DateTime? // employee's last save

  // Rent month by month ({ "YYYY-MM": rent }); annualRentPaid is its total
  rentByMonth   Json?
  // Up to four landlords: [{ name, pan, address, rent }]. The first is
  // mirrored in landlordName / landlordPan.
  landlords     Json?
  // Who the housing loan is from
  lenderName    String @default("")
  lenderPan     String @default("")
  lenderAddress String @default("")

  // DRAFT → SUBMITTED by the employee (who can then no longer change it)
  // → REVIEWED by HR. HR can send it back to DRAFT.
  status      String    @default("DRAFT")
  reviewedAt  DateTime?
  reviewedBy  String    @default("")
  // HR agreed to a reopen request: the employee may edit until they
  // submit again, even with the declaration window closed
  editGranted Boolean   @default(false)

  updatedAt DateTime @updatedAt

  person         Person                     @relation(fields: [personId], references: [id], onDelete: Cascade)
  lines          DeclarationLine[]
  proofs         DeclarationProof[]
  reopenRequests DeclarationReopenRequest[]

  @@unique([personId, fyStart])
  @@index([organizationId, fyStart])
  @@map("employee_tax_profiles")
}

// Catalogue of what an employee can declare for income tax.
// group decides how it feeds the tax engine: the Section 80C pool (capped
// together), the other deductions (each capped on its own), income from
// other heads, tax already paid elsewhere, or an allowance that is exempt
// up to a limit.
model DeclarationItem {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  section        String // as commonly known, e.g. "80C", "80D"
  sectionNew     String   @default("") // number under the Income-tax Act, 2025
  group          String // SECTION_80C | OTHER | OTHER_INCOME | LET_OUT_INCOME | LET_OUT_LOSS | TAX_CREDIT | EXEMPTION
  maxAmount      Float? // cap on this item; null = no cap of its own
  // EXEMPTION items: the pay component the rule is on ("foodAllowance",
  // "c:<componentId>"), what the limit is for, and the regimes it applies under
  componentKey   String   @default("")
  limitPeriod    String   @default("YEAR") // MONTH | YEAR
  regime         String   @default("OLD") // OLD | BOTH
  deductPercent  Float    @default(100) // share of the amount that is deductible
  // An amount on this item needs a proof attached
  proofRequired  Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines DeclarationLine[]

  @@unique([organizationId, code])
  @@map("declaration_items")
}

model DeclarationLine {
  id             String @id @default(cuid())
  profileId      String
  itemId         String
  declaredAmount Float  @default(0)
  approvedAmount Float? // set by HR against proofs
  remarks        String @default("")

  profile EmployeeTaxProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item    DeclarationItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([profileId, itemId])
  @@map("declaration_lines")
}

// An employee asking to change a declaration they have submitted. HR
// decides; approving puts the declaration back to draft for them.
model DeclarationReopenRequest {
  id             String    @id @default(cuid())
  organizationId String
  profileId      String
  reason         String    @default("")
  status         String    @default("PENDING") // PENDING | APPROVED | DECLINED
  decidedBy      String    @default("")
  decidedAt      DateTime?
  decisionNote   String    @default("")
  createdAt      DateTime  @default(now())

  profile EmployeeTaxProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([profileId])
  @@map("declaration_reopen_requests")
}

// A perquisite given to one employee in a financial year, by its line on
// Form 12BA. Its taxable value (value less what the employee paid for it)
// is added to salary for tax.
model PerquisiteValue {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  fyStart        Int
  head           Int // line number on Form 12BA (1-based)
  value          Float    @default(0) // value as per the rules
  recovered      Float    @default(0) // paid by the employee
  updatedAt      DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, fyStart, head])
  @@index([organizationId, fyStart])
  @@map("perquisite_values")
}

// A document supporting a declaration. kind says what it backs: an ITEM
// (itemId set), RENT, HOUSING_LOAN or PREVIOUS_EMPLOYER.
model DeclarationProof {
  id         String   @id @default(cuid())
  profileId  String
  kind       String
  itemId     String?
  fileName   String
  fileData   String // data URI
  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  profile EmployeeTaxProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("declaration_proofs")
}

// Per financial year: whether employees may edit their declaration, upload
// proofs, and choose their own tax regime.
model TaxYearControl {
  organizationId          String
  fyStart                 Int
  declarationOpen         Boolean  @default(false)
  proofOpen               Boolean  @default(false)
  employeeCanChooseRegime Boolean  @default(false)
  // Employees can see their Form 16 for the year once HR releases it
  form16Released          Boolean  @default(false)
  // One-off dates: the declaration window closes after this day, and proof
  // submission opens from this month. Each clears itself once it has acted.
  declarationLockOn       String? // "YYYY-MM-DD"
  proofOpenFrom           String? // "YYYY-MM"
  // Employees see a tax estimate that counts salary not yet released
  employeeTaxEstimate     Boolean  @default(false)
  updatedAt               DateTime @updatedAt

  @@id([organizationId, fyStart])
  @@map("tax_year_controls")
}

// The full working behind the TDS on one payslip, kept so every figure
// on a tax statement can be traced.
model TaxComputation {
  id             String   @id @default(cuid())
  organizationId String
  runId          String
  personId       String
  fyStart        Int
  period         String
  working        Json
  updatedAt      DateTime @updatedAt

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, personId])
  @@index([organizationId, personId, fyStart])
  @@map("tax_computations")
}

// A loan or salary advance recovered through payroll. The schedule holds
// one line per month; a line is DUE until the run that deducts it is
// finalized. Outstanding principal is always derived from transactions.
model Loan {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  loanNo         String // LN-0001, sequential per organization
  title          String   @default("")
  type           String // FLAT | REDUCING | REDUCING_EMI
  principal      Float // amount first disbursed
  annualRate     Float    @default(0)
  instalments    Int // as first agreed
  loanDate       String // "YYYY-MM-DD"
  startPeriod    String // "YYYY-MM" of the first deduction
  status         String   @default("ACTIVE") // ACTIVE | CLOSED
  closedOn       String?
  remarks        String   @default("")
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  person       Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  schedule     LoanScheduleLine[]
  transactions LoanTransaction[]

  @@unique([organizationId, loanNo])
  @@index([organizationId, personId])
  @@map("loans")
}

model LoanScheduleLine {
  id        String  @id @default(cuid())
  loanId    String
  seq       Int
  period    String // "YYYY-MM"
  principal Float
  interest  Float
  status    String  @default("DUE") // DUE | PAID | SKIPPED
  entryId   String? // payslip entry that deducted it

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, seq])
  @@index([period, status])
  @@map("loan_schedule_lines")
}

model LoanTransaction {
  id             String   @id @default(cuid())
  organizationId String
  loanId         String
  date           String // "YYYY-MM-DD"
  period         String   @default("") // payroll month, for instalments
  type           String // DISBURSAL | INSTALMENT | PREPAYMENT | FORECLOSURE | TOP_UP | REVISION | SKIP
  principal      Float    @default(0) // movement in principal: + lent, - repaid
  interest       Float    @default(0) // interest collected
  balanceAfter   Float // principal outstanding after this transaction
  remarks        String   @default("")
  entryId        String?
  createdByName  String   @default("")
  createdAt      DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
  @@index([organizationId, date])
  @@map("loan_transactions")
}

// Professional Tax rules for one state from a given month. MONTHLY states
// pick a slab from the month's gross. HALF_YEARLY states (Tamil Nadu) pick
// one from the half-year's gross (Apr–Sep / Oct–Mar) and recover it either
// spread over the months or as a lump sum in the listed months.
model PtPolicy {
  id              String   @id @default(cuid())
  organizationId  String
  state           String
  // The town (local body) the slabs belong to, matched to a work
  // location's city; blank = the whole state
  locality        String   @default("")
  effectiveFrom   String // "YYYY-MM"
  frequency       String // MONTHLY | HALF_YEARLY
  deductionMode   String   @default("SPREAD") // SPREAD | LUMP_SUM (half-yearly only)
  deductionMonths String   @default("") // LUMP_SUM: month numbers, e.g. "9,3"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slabs PtSlab[]

  @@unique([organizationId, state, locality, effectiveFrom])
  @@map("pt_policies")
}

model PtSlab {
  id         String @id @default(cuid())
  policyId   String
  incomeFrom Float
  incomeTo   Float? // null = no upper limit
  amount     Float

  policy PtPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("pt_slabs")
}

// Labour Welfare Fund contribution for one state from a given month,
// collected in the listed months (e.g. "12" for once a year in December).
model LwfPolicy {
  id              String   @id @default(cuid())
  organizationId  String
  state           String
  effectiveFrom   String // "YYYY-MM"
  employeeAmount  Float
  employerAmount  Float
  deductionMonths String // month numbers, e.g. "12" or "6,12"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, state, effectiveFrom])
  @@map("lwf_policies")
}

// A payment made to a statutory authority for a payroll month.
model Remittance {
  id             String   @id @default(cuid())
  organizationId String
  period         String // "YYYY-MM" the dues belong to
  type           String // PF | ESI | PT | LWF
  amount         Float
  paidOn         String // "YYYY-MM-DD"
  reference      String   @default("")
  bankName       String   @default("")
  remarks        String   @default("")
  createdByName  String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, period])
  @@map("remittances")
}

// Company registrations and the people named on statutory returns
// (quarterly TDS return, Form 16). One row per organization.
model OrgStatutoryProfile {
  organizationId String @id

  // Registrations
  panNumber           String @default("")
  tanNumber           String @default("")
  pfCode              String @default("")
  esiCode             String @default("")
  ptRegistrationNo    String @default("")
  lwfRegistrationNo   String @default("")
  gstNumber           String @default("")
  // Printed on the labour-law registers
  shopsRegistrationNo String @default("") // Shops and Establishments registration certificate
  labourIdNumber      String @default("") // LIN, on the central registers
  natureOfBusiness    String @default("")
  managerName         String @default("") // manager or person in charge of the establishment

  // TDS return
  deductorType     String @default("")
  tdsCircleAddress String @default("")

  // Person responsible for deducting tax
  responsibleName        String @default("")
  responsibleDesignation String @default("")
  responsiblePan         String @default("")
  responsibleAddress     String @default("")
  responsibleEmail       String @default("")
  responsiblePhone       String @default("")

  // Addresses as the TDS return takes them, field by field. Blank fields
  // fall back to the company address and to responsibleAddress.
  deductorFlat              String  @default("")
  deductorBuilding          String  @default("")
  deductorStreet            String  @default("")
  deductorArea              String  @default("")
  deductorCity              String  @default("")
  deductorState             String  @default("")
  deductorPin               String  @default("")
  deductorAddressChanged    Boolean @default(false) // since the last return
  responsibleFlat           String  @default("")
  responsibleBuilding       String  @default("")
  responsibleStreet         String  @default("")
  responsibleArea           String  @default("")
  responsibleCity           String  @default("")
  responsibleState          String  @default("")
  responsiblePin            String  @default("")
  responsibleAddressChanged Boolean @default(false)

  // Form 16 signatory
  form16SignatoryName        String @default("")
  form16SignatoryFatherName  String @default("")
  form16SignatoryDesignation String @default("")
  form16SigningPlace         String @default("")
  form16SignatureData        String @default("") // signature image (data URI)

  updatedAt DateTime @updatedAt

  @@map("org_statutory_profiles")
}

model WorkLocation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String   @default("")
  state          String
  isActive       Boolean  @default(true)
  // No Professional Tax for employees here, whatever the state's policy
  excludeFromPt  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  people          Person[]
  positionChanges PositionChange[]

  @@unique([organizationId, name])
  @@map("work_locations")
}

// One dated step in an employee's position: designation, department, work
// location and grade. Each row holds the whole position from its date, so
// the position on any day is the latest row on or before it. Payslips and
// reports of a month read the row in force at that month's end.
model PositionChange {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  effectiveFrom  String // "YYYY-MM-DD"
  designation    String    @default("")
  department     String    @default("")
  workLocationId String?
  grade          String    @default("")
  reason         String    @default("") // STARTING | PROMOTION | TRANSFER | CORRECTION
  remarks        String    @default("")
  enteredByName  String    @default("")
  // When the employee's own record took these values. A change dated
  // ahead waits with this empty until its day comes.
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  person       Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)

  @@unique([personId, effectiveFrom])
  @@index([organizationId, appliedAt])
  @@map("position_changes")
}

// Append-only trail of payroll changes. runId/entryId/personId are plain
// columns (no foreign keys) and period/personName are snapshots, so the
// trail survives deleting the run or entry it describes.
model PayrollAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  runId          String?
  entryId        String?
  personId       String?
  period         String   @default("")
  personName     String   @default("")
  userId         String?
  userName       String   @default("")
  action         String
  field          String   @default("")
  oldValue       String   @default("")
  newValue       String   @default("")
  source         String   @default("MANUAL") // MANUAL | IMPORT | REVISION
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([runId])
  @@map("payroll_audit_logs")
}

// ---------------------------------------------------------------------------
// Recruitment module
// ---------------------------------------------------------------------------
model JobPosting {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  department      String   @default("")
  location        String   @default("")
  description     String   @default("")
  requirements    String   @default("")
  employmentType  String   @default("FULL_TIME")
  experienceRange String   @default("")
  salaryRange     String   @default("")
  status          String   @default("DRAFT")
  postedDate      String?
  closingDate     String?
  positionsCount  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([organizationId, status])
  @@map("job_postings")
}

model JobApplication {
  id             String   @id @default(cuid())
  organizationId String
  jobPostingId   String
  applicantName  String
  applicantEmail String   @default("")
  applicantPhone String   @default("")
  resumeNotes    String   @default("")
  coverLetter    String   @default("")
  stage          String   @default("APPLIED")
  appliedDate    String
  stageUpdatedAt DateTime @default(now())
  rating         Int?
  notes          String   @default("")
  personId       String? // set when a hired applicant is added to People
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobPostingId, stage])
  @@map("job_applications")
}

model FeatureStatus {
  id             String   @id @default(cuid())
  clientId       String
  organizationId String
  name           String
  status         String   @default("NOT_STARTED")
  engineer       String   @default("")
  startedOn      String?
  completedOn    String?
  remarks        String   @default("")
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  client IncomeClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([organizationId])
  @@map("feature_statuses")
}

// One payment instruction for a run: the salaries paid together by one mode.
model PayoutBatch {
  id             String    @id @default(cuid())
  organizationId String
  runId          String
  batchNo        Int // running number within the organization
  batchRef       String    @default("") // from the number series, when one is set up
  mode           String // BANK | CHEQUE | CASH
  payDate        String // "YYYY-MM-DD"
  reference      String    @default("")
  status         String    @default("PREPARED") // PREPARED | PAID
  notes          String    @default("")
  createdBy      String    @default("")
  paidAt         DateTime?
  // The company account a bank batch is paid from
  bankAccountId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  run         PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  bankAccount CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  entries     PayslipEntry[]

  @@unique([organizationId, batchNo])
  @@index([runId])
  @@map("payout_batches")
}

// A company bank account. Salary batches are paid from one of them; the
// default is offered first.
model CompanyBankAccount {
  id             String   @id @default(cuid())
  organizationId String
  label          String   @default("") // what the account is called in-house, e.g. "Salary account"
  bankName       String
  branch         String   @default("")
  accountNumber  String
  ifsc           String   @default("")
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches PayoutBatch[]

  @@index([organizationId])
  @@map("company_bank_accounts")
}

// One value of an editable list (department, designation, bank and so
// on). Records store the label itself, so renaming a value renames it on
// the records that use it.
model ListValue {
  id             String   @id @default(cuid())
  organizationId String
  listType       String // see LIST_TYPES in services/masters.ts
  label          String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, listType, label])
  @@map("list_values")
}

// Ledger account for a line of the payroll journal voucher. The key is a
// pay column ("basic", "c:<componentId>") or a control account ("pfPayable").
model LedgerMapping {
  organizationId String
  key            String
  ledgerName     String
  updatedAt      DateTime @updatedAt

  @@id([organizationId, key])
  @@map("ledger_mappings")
}

// A ledger of its own for one department or work location, used when the
// journal voucher is split that way. Without one, the mapping above applies.
model LedgerOverride {
  organizationId String
  dimension      String // DEPARTMENT | LOCATION
  groupName      String
  key            String
  ledgerName     String
  updatedAt      DateTime @updatedAt

  @@id([organizationId, dimension, groupName, key])
  @@map("ledger_overrides")
}

// A deposit of tax deducted from salaries, as on the bank challan. The
// quarterly TDS return lists each challan and the employees it covers.
model TdsChallan {
  id             String   @id @default(cuid())
  organizationId String
  period         String // "YYYY-MM": the salary month whose TDS it deposits
  fyStart        Int
  quarter        Int // 1 = Apr–Jun … 4 = Jan–Mar
  bsrCode        String // 7-digit code of the bank branch
  challanSerial  String // 5-digit challan serial number
  depositedOn    String // "YYYY-MM-DD"
  tds            Float    @default(0) // income tax
  surcharge      Float    @default(0)
  cess           Float    @default(0)
  interest       Float    @default(0)
  fee            Float    @default(0) // late filing fee
  others         Float    @default(0)
  minorHead      String   @default("200") // 200 = TDS payable by taxpayer, 400 = regular assessment
  remarks        String   @default("")
  createdByName  String   @default("")
  createdAt      DateTime @default(now())

  allocations TdsChallanAllocation[]

  @@index([organizationId, fyStart, quarter])
  @@map("tds_challans")
}

// A quarter's TDS return as filed: the receipt (token) number the tax
// department gave it. The next quarter's return quotes it.
model TdsReturnFiling {
  organizationId String
  fyStart        Int
  quarter        Int
  receiptNo      String   @default("")
  filedOn        String   @default("") // "YYYY-MM-DD"
  updatedAt      DateTime @updatedAt

  @@id([organizationId, fyStart, quarter])
  @@map("tds_return_filings")
}

// How much of a challan covers one employee's TDS for the month.
model TdsChallanAllocation {
  id        String @id @default(cuid())
  challanId String
  entryId   String
  personId  String
  amount    Float

  challan TdsChallan   @relation(fields: [challanId], references: [id], onDelete: Cascade)
  entry   PayslipEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([challanId, entryId])
  @@index([entryId])
  @@map("tds_challan_allocations")
}

// Form 16 Part A, downloaded from the tax department's portal, kept
// beside the Part B the system produces.
model Form16PartA {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  fyStart        Int
  fileName       String
  fileData       String // PDF as a data URI
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, fyStart])
  @@index([organizationId, fyStart])
  @@map("form16_part_a")
}

// Pay owed for a month that is already finalized: a back-dated salary
// revision, or loss-of-pay days reversed. It is paid as a line on a later
// payslip, with PF and ESI on it.
model ArrearItem {
  id             String  @id @default(cuid())
  organizationId String
  personId       String
  // REVISION (amounts are negative for a back-dated cut that is recovered)
  // | LOP_REVERSAL | LOP_RECOVERY (loss of pay added to a past month)
  kind           String
  sourcePeriod   String // "YYYY-MM" the month being corrected
  sourceEntryId  String
  revisionId     String?
  lopDays        Float   @default(0) // days reversed (LOP_REVERSAL) or added (LOP_RECOVERY)
  fromPackage    Float   @default(0)
  toPackage      Float   @default(0)

  basic              Float @default(0)
  da                 Float @default(0)
  hra                Float @default(0)
  transportAllowance Float @default(0)
  foodAllowance      Float @default(0)
  // Of the gross: recurring earnings that are reduced for loss of pay
  recurring          Float @default(0)
  gross              Float @default(0)
  pfEmployee         Float @default(0)
  pfEmployer         Float @default(0)
  esiEmployee        Float @default(0)
  esiEmployer        Float @default(0)

  status        String    @default("OPEN") // OPEN | CANCELLED; paid once its payslip's run is finalized
  paidEntryId   String?
  reason        String    @default("")
  createdByName String    @default("")
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?

  person      Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  sourceEntry PayslipEntry    @relation("ArrearSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  paidEntry   PayslipEntry?   @relation("ArrearPaid", fields: [paidEntryId], references: [id], onDelete: SetNull)
  revision    SalaryRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([organizationId, personId])
  @@index([sourceEntryId])
  @@index([paidEntryId])
  @@map("arrear_items")
}

// Full and final settlement of an employee who is leaving. Its amounts are
// paid as lines on the employee's payslip for the chosen month. A later
// correction is a new settlement (sequence 2, 3…) that pays the difference.
model Settlement {
  id             String  @id @default(cuid())
  organizationId String
  personId       String
  sequence       Int     @default(1)
  settlementNo   String  @default("") // from the number series, when one is set up
  period         String // "YYYY-MM" the payroll month it is paid in
  entryId        String?

  lastWorkingDate String // "YYYY-MM-DD"
  resignedOn      String?
  reason          String  @default("")
  payDays         Float? // paid days in the settlement month; null leaves the run's attendance alone

  // Workings, kept for the statement
  monthlyGross     Float @default(0)
  basicDa          Float @default(0)
  serviceYears     Float @default(0)
  noticeDays       Float @default(0)
  noticeServedDays Float @default(0)
  noticePayDays    Float @default(0)
  leaveDays        Float @default(0)
  gratuityYears    Float @default(0)

  // Amounts to pay or recover: totals as they should finally stand
  leaveEncashment Float @default(0)
  gratuity        Float @default(0)
  noticePay       Float @default(0)
  noticeRecovery  Float @default(0)

  remarks       String   @default("")
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  entry  PayslipEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([personId, sequence])
  @@index([organizationId, period])
  @@map("settlements")
}

// An employee's proposed change to their own details (phase 26). Nothing
// on the Person changes until HR approves; a bank change needs a proof.
model ChangeRequest {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  section        String // CONTACT | ADDRESS | EMERGENCY | BANK | FAMILY
  // { field: { from, to } } for scalar sections; a proposed member for FAMILY
  changes        Json      @default("{}")
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  // Bank changes carry a proof file
  fileName       String    @default("")
  mimeType       String    @default("")
  sizeBytes      Int       @default(0)
  fileData       String    @default("")
  storage        String    @default("DB")
  storageKey     String    @default("")
  reviewedByName String    @default("")
  reviewNote     String    @default("")
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([personId])
  @@map("change_requests")
}

// A notice on the bulletin board (phase 26). Employees in scope see it on
// their updates until it expires.
model Bulletin {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  body           String   @default("")
  scope          String   @default("EVERYONE") // EVERYONE | DEPARTMENT | LOCATION
  scopeValue     String   @default("") // department label or work-location id
  fileName       String   @default("")
  mimeType       String   @default("")
  sizeBytes      Int      @default(0)
  fileData       String   @default("")
  storage        String   @default("DB")
  storageKey     String   @default("")
  expiresOn      String? // "YYYY-MM-DD"; null = no expiry
  isActive       Boolean  @default(true)
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isActive])
  @@map("bulletins")
}

// A company policy published to employees (phase 26), who record that they
// have read it.
model Policy {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  body           String   @default("")
  scope          String   @default("EVERYONE")
  scopeValue     String   @default("")
  fileName       String   @default("")
  mimeType       String   @default("")
  sizeBytes      Int      @default(0)
  fileData       String   @default("")
  storage        String   @default("DB")
  storageKey     String   @default("")
  isActive       Boolean  @default(true)
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@index([organizationId, isActive])
  @@map("policies")
}

model PolicyAcknowledgement {
  id             String   @id @default(cuid())
  organizationId String
  policyId       String
  personId       String
  acknowledgedAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([policyId, personId])
  @@index([organizationId, policyId])
  @@map("policy_acknowledgements")
}

// A mail sent to a group of employees (phase 26), sent one at a time in
// the background through the company mail server; every mail is in the
// mail log as well.
model MailCampaign {
  id             String    @id @default(cuid())
  organizationId String
  subject        String
  body           String    @default("")
  scope          String // EVERYONE | DEPARTMENT | LOCATION | CHOSEN
  scopeValue     String    @default("")
  personIds      Json      @default("[]") // for CHOSEN
  status         String    @default("SENDING") // SENDING | DONE
  total          Int       @default(0)
  sent           Int       @default(0)
  failed         Int       @default(0)
  createdByName  String    @default("")
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([organizationId, createdAt])
  @@map("mail_campaigns")
}
